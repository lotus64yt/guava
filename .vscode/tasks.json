{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start Expo Server (npm run start)",
      "type": "shell",
      "command": "npm run start",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "Build APK local (gradlew assembleRelease)",
      "type": "shell",
      "command": "cd android && ./gradlew assembleRelease && cp app/build/outputs/apk/release/app-release.apk ../guava-release.apk",
      "group": "build",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
